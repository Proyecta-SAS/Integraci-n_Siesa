SIESA_ENV=qa
SIESA_DRY_RUN=true

# Google Sheets can be consumed through a CSV export URL or through a local CSV
# generated from the spreadsheet tab.
SIESA_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/<spreadsheet_id>/export?format=csv&gid=<gid>
SIESA_INPUT_CSV=

# Siesa HUB.
SIESA_HUB_BASE_URL=https://<qa-or-prod-siesa-hub-host>
SIESA_HUB_CONNECTOR_ID=142888
SIESA_HUB_OPERATION=API_v1_ReciboCaja
SIESA_HUB_TOKEN=
SIESA_HUB_AUTH_SCHEME=Bearer
SIESA_HUB_EXECUTE_PATH=/api/v1/connectors/{connector_id}/execute
SIESA_HUB_METADATA_PATH=/api/v1/connectors/{connector_id}

# ERP/Siesa values supplied by the client's parametrization.
SIESA_TIPO_DOCUMENTO=RCW
SIESA_ESTADO_DOCUMENTO=1
SIESA_ID_CAJA=
SIESA_MONEDA_RECAUDO=COP
SIESA_MONEDA_APLICACION=COP
SIESA_CONCEPTO_FLUJO_EFECTIVO=

# Sync behavior.
SIESA_STATE_FILE=.state/siesa_payments_state.json
SIESA_LOG_FILE=logs/siesa_payments.jsonl
SIESA_CONFIG_FILE=config/siesa_recibo_caja_mapping.json

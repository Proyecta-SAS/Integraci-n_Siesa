SIESA_ENV=qa
SIESA_DRY_RUN=true
SIESA_ALLOW_SEND=false
SIESA_SEND_COOLDOWN_MINUTES=15
# Espera de red del POST a Siesa; una respuesta no confirmada nunca se reenvia automaticamente.
SIESA_REQUEST_TIMEOUT_SECONDS=120
SIESA_RECIBO_FLUJO=otros_ingresos

# Google Sheets can be consumed through a CSV export URL or through a local CSV.
# Current operational tab: ALEGRA - ALIANZA JURIDICA AVANZAR / Ingreso / Egreso.
SIESA_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/1TuXSZESNm1xJGJvXLMKTq2bAY1ZvmCl6n8Aez1FRVp8/export?format=csv&gid=0
SIESA_INPUT_CSV=

# Escritura de estados en la misma hoja mediante scripts/sheets_writeback.gs.
# Habilitar solo despues de desplegar el webhook y configurar sus propiedades.
SIESA_SHEETS_WRITEBACK_ENABLED=false
SIESA_SHEETS_WEBHOOK_URL=
SIESA_SHEETS_WEBHOOK_TOKEN=

# Siesa HUB / Gestor de Integraciones.
# Prefer SIESA_CONNECTOR_URL when using "Copiar URL" from the connector guide.
SIESA_CONNECTOR_URL=
# Alias useful when Siesa's "Local" base URL is the production target.
SIESA_BASE_URL=
SIESA_HUB_BASE_URL=
SIESA_HUB_EXECUTE_PATH=/apisestandar/v3/conectoresimportar
SIESA_HUB_CONNECTOR_ID=261128
SIESA_HUB_OPERATION=API_v2_ReciboCaja

# Values copied from the Siesa Documentador connector guide.
SIESA_CONN_KEY=
SIESA_CONN_TOKEN=
SIESA_CLIENT_ID=
SIESA_CLIENT_SECRET=
SIESA_ID_COMPANIA=
SIESA_F_CIA=
SIESA_ID_ECOSISTEMA=
SIESA_ID_DOCUMENTO=261128
SIESA_NOMBRE_DOCUMENTO=API_v2_ReciboCaja

# ERP/Siesa values supplied by the client's parametrization.
SIESA_TIPO_DOCUMENTO=RCW
SIESA_CONSEC_AUTO_REG=1
SIESA_CONSEC_DOCTO=0
SIESA_ID_CO=
SIESA_ID_CAJA=
SIESA_ID_BANCO=
SIESA_NRO_CUENTA=
SIESA_ID_MONEDA=COP
SIESA_ID_MONEDA_APLICAR=COP
SIESA_ID_COBRADOR=
SIESA_ID_UN=
SIESA_ID_FE=
# Código ERP del medio de pago de consignación. No usar EFE: EFE es efectivo.
SIESA_ID_MEDIO_PAGO_CONSIGNACION=
SIESA_VALIDA_MEDIO_PAGO=0
SIESA_DOCTO_BANCO_CG=CG

# Default flow validated with contabilidad: Recibos de caja > Otros ingresos.
SIESA_AUXILIAR_OTRO_ING=28050505
SIESA_SUCURSAL_OTRO_ING=001
SIESA_ID_CO_OTRO_ING=
SIESA_ID_UN_OTRO_ING=
SIESA_CCOSTO_OTRO_ING=

# Optional legacy CxC document to apply/cross when SIESA_RECIBO_FLUJO=cartera.
SIESA_TIPO_DOCTO_CRUCE=
SIESA_CONSEC_DOCTO_CRUCE=
SIESA_AUXILIAR_DOCTO_CRUCE=
SIESA_ID_CO_CRUCE=
SIESA_ID_UN_CRUCE=
SIESA_SUCURSAL_DOCTO_CRUCE=
SIESA_NRO_CUOTA_CRUCE=0

# Sync behavior.
SIESA_STATE_FILE=.state/siesa_payments_state.json
SIESA_LOG_FILE=logs/siesa_payments.jsonl
SIESA_CONFIG_FILE=config/siesa_recibo_caja_mapping.json

# Login e historico. PostgreSQL privado en produccion; SQLite solo para desarrollo.
SIESA_DATABASE_URL=sqlite:///.state/application.db
# Cuenta inicial: usuario o correo. Solo se crea si aun no existen usuarios.
SIESA_BOOTSTRAP_ADMIN_EMAIL=admin
# Generar con: python -m siesa_payments.manage hash-password
# No poner la contrasena en texto plano aqui.
SIESA_BOOTSTRAP_ADMIN_PASSWORD_HASH=

# Activadores Alegra. Usar los cuatro webhooks existentes del proyecto
# Activadores-Alegras. Solo se consultan desde el servidor, nunca desde el navegador.
# Cada cuenta mantiene una espera independiente de 15 minutos en la base de datos.
ALEGRA_WEBHOOK_ANTIGUO=
ALEGRA_WEBHOOK_LIDERA=
ALEGRA_WEBHOOK_ALIANZA=
ALEGRA_WEBHOOK_PROSPERAR=

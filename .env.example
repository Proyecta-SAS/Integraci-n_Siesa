SIESA_ENV=qa
SIESA_DRY_RUN=true
SIESA_ALLOW_SEND=false
SIESA_SEND_COOLDOWN_MINUTES=15

# Google Sheets can be consumed through a CSV export URL or through a local CSV.
# Current operational tab: ALEGRA - ALIANZA JURIDICA AVANZAR / Ingreso / Egreso.
SIESA_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/1TuXSZESNm1xJGJvXLMKTq2bAY1ZvmCl6n8Aez1FRVp8/export?format=csv&gid=0
SIESA_INPUT_CSV=

# Siesa HUB / Gestor de Integraciones.
# Prefer SIESA_CONNECTOR_URL when using "Copiar URL" from the connector guide.
SIESA_CONNECTOR_URL=
SIESA_HUB_BASE_URL=
SIESA_HUB_EXECUTE_PATH=/apisestandar/v3/conectoresimportar
SIESA_HUB_CONNECTOR_ID=142888
SIESA_HUB_OPERATION=API_v1_ReciboCaja

# Values copied from the Siesa Documentador connector guide.
SIESA_CONN_KEY=
SIESA_CONN_TOKEN=
SIESA_CLIENT_ID=
SIESA_CLIENT_SECRET=
SIESA_ID_COMPANIA=
SIESA_F_CIA=
SIESA_ID_ECOSISTEMA=
SIESA_ID_DOCUMENTO=142888
SIESA_NOMBRE_DOCUMENTO=API_v1_ReciboCaja

# ERP/Siesa values supplied by the client's parametrization.
SIESA_TIPO_DOCUMENTO=RCW
SIESA_CONSEC_AUTO_REG=1
SIESA_CONSEC_DOCTO=0
SIESA_ID_CO=
SIESA_ID_CAJA=
SIESA_ID_BANCO=
SIESA_NRO_CUENTA=
SIESA_ID_MONEDA=COP
SIESA_ID_MONEDA_APLICAR=COP
SIESA_ID_COBRADOR=
SIESA_ID_UN=
SIESA_ID_FE=
SIESA_VALIDA_MEDIO_PAGO=0
SIESA_DOCTO_BANCO_CG=CG

# CxC document to apply/cross.
# For QA these can be filled for one known invoice.
# For production, prefer per-row Google Sheets columns:
# Documento cruce, C.O. cruce, U.N. cruce, Sucursal cruce, Auxiliar cruce.
SIESA_TIPO_DOCTO_CRUCE=
SIESA_CONSEC_DOCTO_CRUCE=
SIESA_AUXILIAR_DOCTO_CRUCE=
SIESA_ID_CO_CRUCE=
SIESA_ID_UN_CRUCE=
SIESA_SUCURSAL_DOCTO_CRUCE=
SIESA_NRO_CUOTA_CRUCE=0

# Sync behavior.
SIESA_STATE_FILE=.state/siesa_payments_state.json
SIESA_LOG_FILE=logs/siesa_payments.jsonl
SIESA_CONFIG_FILE=config/siesa_recibo_caja_mapping.json
